# Token du bot Discord (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Cle API Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optionnel : IDs de salons Discord ou le bot doit ecouter, separes par des virgules.
